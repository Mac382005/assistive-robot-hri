# V3 optional cloud companion AI
# Never commit a real API key to Git.
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=220
AI_TIMEOUT_SECONDS=15

# Adaptive reminder follow-up (V4.2)
REMINDER_FOLLOWUP_SECONDS=20
REMINDER_MAX_FOLLOWUPS=3

# Tablet/base voice mode (V4.3)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
TABLET_AUDIO_MAX_BYTES=8388608
# SSL_CERT_PATH and SSL_KEY_PATH are set automatically by tools/run_tablet_https.ps1

# Cloud deployment (V4.5)
# Local development can leave CLOUD_MODE/CLOUD_AUTH_REQUIRED false.
# On Railway set CLOUD_MODE=true and CLOUD_AUTH_REQUIRED=true.
CLOUD_MODE=false
APP_TIMEZONE=
CLOUD_AUTH_REQUIRED=false
CLOUD_ACCESS_CODE=
APP_SECRET_KEY=
CLOUD_SESSION_DAYS=30
# Optional storage overrides. Railway volumes are auto-detected via
# RAILWAY_VOLUME_MOUNT_PATH, so these are normally left blank there.
DATA_DIR=
DATABASE_PATH=

